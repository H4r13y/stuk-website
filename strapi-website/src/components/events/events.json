{
  "collectionName": "components_events_events",
  "info": {
    "displayName": "Event",
    "icon": "calendar"
  },
  "options": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "StartTime": {
      "type": "datetime",
      "required": true,
      "default": "2026-02-22T18:00:18.400Z"
    },
    "Public": {
      "type": "boolean"
    },
    "Description": {
      "type": "blocks"
    },
    "Media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Link": {
      "type": "richtext"
    },
    "SpecialEvent": {
      "type": "boolean"
    },
    "Lables": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::label.label"
    }
  },
  "config": {}
}
